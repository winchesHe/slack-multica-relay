# Slack App 与准入范围。白名单支持 all；黑名单优先于白名单。
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_TARGET_USER_IDS=
SLACK_TARGET_SUBTEAM_IDS=
SLACK_ALLOWED_CHANNEL_IDS=all
SLACK_BLOCKED_CHANNEL_IDS=
SLACK_ALLOWED_SENDER_IDS=all
SLACK_BLOCKED_SENDER_IDS=
# Owner USER token: reactions and Agent replies must use the same owner identity.
SLACK_REACTION_TOKEN=
SLACK_REACTION_NAME=eyes

# 普通 Multica Issue API；无需 Autopilot 或 Webhook。
MULTICA_API_BASE_URL=https://multica.example.com
MULTICA_API_TOKEN=
MULTICA_WORKSPACE_ID=
MULTICA_PROJECT_ID=
MULTICA_AGENT_ID=

# 本项目专用 Redis：线程映射和写入确认状态，默认保留90天。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# QStash：持久化收件、后台投递、重试与失败保留。
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# 必须是当前部署公开的准确 URL，供发送和验签共同使用。
RELAY_CONSUMER_URL=https://relay.example.com/api/queue/consume

# 完成 Hook（默认关闭，仅 Vercel；旧模型快照查询已删除）。
RELAY_FOOTER_ENABLED=false
MULTICA_PLUGIN_INSTALLATION_ID=
# Multica 安装产生的 whsec_ + 64 位十六进制签名密钥。
MULTICA_PLUGIN_SIGNING_SECRET=
# Runtime 到回复登记接口的独立随机凭据，至少 32 字符。
RELAY_REPLY_TOKEN=
# 必须与 Runtime 发送身份相同，user 或 bot；不自动切换身份。
SLACK_REPLY_ACTOR=user
SLACK_REPLY_TOKEN=
# Bot 无法读取原 thread 时显式配置同一工作区的读取凭据。
SLACK_READ_TOKEN=

# 以下只在 Multica Agent / Runtime 配置，不从 Slack 消息取值。
# Runtime 也需要 RELAY_FOOTER_ENABLED、RELAY_REPLY_TOKEN、SLACK_REPLY_ACTOR、SLACK_TEAM_ID。
RELAY_REPLY_SCRIPT=/absolute/path/slack-multica-relay/scripts/reply.py
RELAY_SLACK_CLI=/absolute/path/slack/scripts/slack.py
RELAY_REPLY_REGISTER_URL=https://relay.example.com/api/slack/replies
# 运行间持久化、权限仅限运行用户；勿放在每次任务自动删除的临时目录。
RELAY_RECEIPT_DIR=/absolute/path/relay-receipts
