# Slack Events API 的 Signing Secret，只用于验证入站请求。
SLACK_SIGNING_SECRET=

# Multica Autopilot 的 Webhook URL；该 URL 本身是调用凭证。
MULTICA_WEBHOOK_URL=

# 开启后，同一 Slack 根 thread 复用同一张 Multica issue 卡片。
SLACK_THREAD_ROUTING_ENABLED=false

# 线程路由需要调用 Multica API 查询 issue 并追加评论。
MULTICA_API_BASE_URL=https://multica.devops.moego.dev
MULTICA_API_TOKEN=
MULTICA_WORKSPACE_ID=
# Autopilot UUID（不是 webhook URL 中的 awt_ 凭证）。
MULTICA_AUTOPILOT_ID=

# Upstash/Vercel KV REST 凭证，用于保存 thread → issue 映射、幂等状态和并发锁。
# 若 Marketplace 自动注入 UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN，也可以直接使用那组名称。
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 用于给命中消息添加 reaction 的 Slack User Token。
SLACK_REACTION_TOKEN=

# 可选；若不填则复用 SLACK_REACTION_TOKEN。用于读取未映射 thread 的根消息。
SLACK_READ_TOKEN=

# Slack reaction 名称，可写成 lark_onesecond 或 :lark_onesecond:。
SLACK_REACTION_NAME=lark_onesecond

# 需要触发的真人 User ID，逗号分隔，例如 U12345678,U23456789。
SLACK_TARGET_USER_IDS=

# 需要触发的 Slack User Group ID，逗号分隔，例如 S12345678。
SLACK_TARGET_SUBTEAM_IDS=
