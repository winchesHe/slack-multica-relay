{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vitest"]
  },
  "include": [
    "api/**/*.ts",
    "cloud-functions/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.test.ts"
  ]
}
